{
  "name": "lsbranch",
  "version": "0.5.0",
  "description": "A simple tool for listing the active branches in git clones. ",
  "scripts": {
    "build": "heft build --clean",
    "_phase:build": "heft run --only build -- --clean",
    "_phase:test": "heft run --only test -- --clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iclanton/lsbranch.git",
    "directory": "lsbranch"
  },
  "author": "iclanton",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iclanton/lsbranch/issues"
  },
  "homepage": "https://github.com/iclanton/lsbranch#readme",
  "bin": {
    "lsbranch": "./bin/lsbranch"
  },
  "files": [
    "lib/**/*",
    "bin/**/*"
  ],
  "devDependencies": {
    "@rushstack/eslint-config": "4.9.0",
    "@rushstack/heft-json-schema-typings-plugin": "1.2.33",
    "@rushstack/heft-node-rig": "2.11.56",
    "@rushstack/heft": "1.3.5",
    "@types/heft-jest": "1.0.2",
    "@types/node": "~22.18.7",
    "@types/semver": "^7.7.0",
    "typescript": "~5.8.2"
  },
  "dependencies": {
    "@rushstack/node-core-library": "5.25.2",
    "@rushstack/terminal": "0.24.8",
    "@rushstack/ts-command-line": "5.3.18",
    "minimatch": "^10.2.6",
    "semver": "^7.7.2"
  }
}
