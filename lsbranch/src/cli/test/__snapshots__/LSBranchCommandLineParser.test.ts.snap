exports[`LSBranchCommandLineParser prints the global help 1`] = `
"usage: lsbranch [-h] [-c PATH] <command> ...

LSBranch is a simple tool for listing the active branches in git clones.

Positional arguments:
  <command>
    ls                  List branches.
    add                 Add a repo.
    find                Find clones containing a local branch.
    remove              Unregister a repository.

Optional arguments:
  -h, --help            Show this help message and exit.
  -c PATH, --config PATH
                        Override the config file path. Defaults to ~/.
                        lsbranchrc.json

[bold]For detailed help about a specific command, use: lsbranch <command> 
-h[normal]
"
`;

exports[`LSBranchCommandLineParser prints the help for each action: add 1`] = `
"usage: lsbranch add [-h] --path REPO_PATH [--alias ALIAS] [--no-validate]

Optional arguments:
  -h, --help        Show this help message and exit.
  --path REPO_PATH  The path to the repo root
  --alias ALIAS     The repo's alias
  --no-validate     If specified, do not ensure that the repo being added 
                    exists and is valid.
"
`;

exports[`LSBranchCommandLineParser prints the help for each action: find 1`] = `
"usage: lsbranch find [-h] --branch NAME [--json]

Matches an exact local branch name, whether or not it is checked out.

Optional arguments:
  -h, --help     Show this help message and exit.
  --branch NAME  The exact local branch name to find.
  --json         Present matching clones and repository errors in JSON format.
"
`;

exports[`LSBranchCommandLineParser prints the help for each action: ls 1`] = `
"usage: lsbranch ls [-h] [--json] [-a] [--other]

Optional arguments:
  -h, --help  Show this help message and exit.
  --json      If specified, present data in JSON format.
  -a, --all   If specified, display all local branches.
  --other     List only local branches that are not checked out in each clone.
"
`;

exports[`LSBranchCommandLineParser prints the help for each action: remove 1`] = `
"usage: lsbranch remove [-h] [--path REPO_PATH] [--alias ALIAS]

Remove a registered repository by path or alias, without deleting its files.

Optional arguments:
  -h, --help        Show this help message and exit.
  --path REPO_PATH  The path of the registered repository to remove.
  --alias ALIAS     The exact alias of the registered repository to remove.
"
`;

